# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is git-ignored for this reason.
# NEVER paste real credentials into any chat or email.
# Every variable the project needs is listed here with a placeholder only.

# PostgreSQL connection string (from Supabase: Project Settings > Database > URI)
DATABASE_URL=postgres://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase project URL and API keys (from Supabase: Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Supabase Storage bucket name for raw data lake
STORAGE_BUCKET=raw-lake

# --- Serving the public API (all optional; see docs/SECURITY_REVIEW_2026-09-06.md)
# Without these the API serves exactly as it does today, with its always-on
# request and response limits. Each one closes one finding from that review.

# The read-only database identity for the public API. DATABASE_URL owns the
# warehouse and can write to it; the API never needs either. Create the role
# with db/migrations/0008_api_access.sql, give it a password, and put its
# connection string here. Falls back to DATABASE_URL, with a warning, if unset.
# API_DATABASE_URL=postgres://portal_api:its-own-password@db.your-project-ref.supabase.co:5432/postgres

# Turns on the shared per-caller request allowance (needs migration 0008).
# Any random string of 32+ characters; it salts the hashed caller address so
# the allowance table cannot be turned back into a list of visitors' IPs.
# API_CLIENT_HASH_KEY=generate-32-or-more-random-characters

# TLS: the API verifies the database server's identity as soon as a certificate
# authority is available, and only encrypts (without verifying) before that.
# Supabase signs its pooler with its own private CA, so download the
# certificate from Settings > Database > SSL Configuration and save it as
# reference/supabase/prod-ca-2021.crt. These two override that default.
# API_SSL_ROOT_CERT=/path/to/ca.crt
# API_SSL_MODE=verify-full
